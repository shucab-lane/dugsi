# Option A: demo mode (no backend needed; seeded sample data stored in the browser)
# VITE_DEMO_MODE=true

# Option B: real backend
# Supabase project URL and anon (public) key: Project settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe (optional - only needed for online payments)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Used only by Edge Functions (set via `supabase secrets set ...`)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_MONTHLY_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
